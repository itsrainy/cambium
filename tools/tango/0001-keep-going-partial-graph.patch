+			// hide a difference between the targets that did load.
+			p.Targets[p.TargetName] = &Target{
+				Name:            p.TargetName,
+				RuleType:        ExternalRuleType,
+				External:        true,
+				Hash:            []byte{},
+				HashWithoutDeps: []byte{},
+			}
+			return []byte{}, nil
 		}
 
 		path := filepath.Join(p.WorkspaceRoot, l.Package, l.Target)
